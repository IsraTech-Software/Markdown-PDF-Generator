def _extract_metadata_from_markdown(md_text: str) -> dict:
    """Dynamically parses the markdown text to extract and sanitize metadata fields, ignoring comments."""
    metadata = {
        "title": "Curriculum Vitae",
        "description": "Professional Curriculum Vitae and Experience Record",
        "keywords": "Resume, CV, Professional Experience"
    }
    
    # 1. Extract Title (First Markdown # heading)
    title_match = re.search(r'^\s*#\s+(.+)$', md_text, re.MULTILINE)
    if title_match:
        raw_title = re.sub(r'<[^>]+>', '', title_match.group(1)).strip()
        metadata["title"] = _sanitize_attr(raw_title)
        
    # 2. Clean text for description and keywords generation (stripping comments automatically via _clean_markdown_for_ai)
    cleaned = _clean_markdown_for_ai(md_text)
    if cleaned:
        desc_snippet = cleaned[:160] + "..." if len(cleaned) > 160 else cleaned
        metadata["description"] = _sanitize_attr(desc_snippet)
        
        # Pull unique words for meta keywords
        words = [w.strip(".,()[]{}:;") for w in cleaned.split() if len(w) > 4]
        unique_keywords = sorted(list(set(words)), key=words.index)[:15]
        metadata["keywords"] = _sanitize_attr(", ".join(unique_keywords))
        
    return metadata


def _generate_html_output(custom_css: str, pygments_css: str, logo_html: str, html_body: str, ai_hidden_html: str, metadata: dict) -> str:
    return f"""
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>{metadata['title']}</title>
        <meta name="author" content="{metadata['title']}">
        <meta name="description" content="{metadata['description']}">
        <meta name="keywords" content="{metadata['keywords']}">
        <style>
            {custom_css}
            {pygments_css}
        </style>
    </head>
    <body>
        {logo_html}
        {html_body}
        {ai_hidden_html}
    </body>
    </html>
    """


def _render_pdf(html: str, input_file_path: str, output_file_path: str, enable_metadata: bool) -> None:
    print(f"Converting '{input_file_path}' to '{output_file_path}'...")
    base_dir = os.path.abspath(os.path.dirname(input_file_path))
    HTML(string=html, base_url=base_dir).write_pdf(output_file_path, custom_metadata=enable_metadata)
    print("PDF generated successfully.")


def _apply_table_alignment(html_body: str) -> str:
    centered_pattern = r'<td>\s*\\c\s*(.*?)</td>'
    html_body = re.sub(centered_pattern, r'<td style="text-align: center;">\1</td>', html_body, flags=re.DOTALL)
    right_pattern = r'<td>\s*\\r\s*(.*?)</td>'
    return re.sub(right_pattern, r'<td style="text-align: right;">\1</td>', html_body, flags=re.DOTALL)


def convert_md_to_pdf(input_file, output_file, logo, css, extract_metadata, job_file) -> None:
    """
    Converts the given markdown file to pdf.
    :param input_file: Markdown input file path.
    :param output_file: PDF output file path.
    :param logo: (Optional) Path to image file to include as logo.
    :param css: (Optional) Custom css stylesheet.
    :param extract_metadata: (Boolean) Whether to dynamically parse metadata from markdown.
    :param job_file: (Optional) Path to job description text/markdown file.
    """
    _ensure_exists(input_file=input_file)
    
    md_text = _get_md_text(input_file=input_file)
    
    job_text = ""
    if job_file:
        _ensure_exists(job_file)
        job_text = _get_md_text(job_file)

    # Conditionally extract metadata or keep default fallbacks
    if extract_metadata:
        metadata = _extract_metadata_from_markdown(md_text)
    else:
        metadata = {
            "title": "Curriculum Vitae",
            "description": "Professional Curriculum Vitae and Experience Record",
            "keywords": "Resume, CV, Professional Experience"
        }
        
    ai_hidden_html = _generate_ai_hidden_layer(md_text, job_text)
    
    # Process regular markdown content
    processed_md = _apply_page_breaks(md_text=md_text)
    processed_md = _apply_mathjax(md_text=processed_md)
    
    extensions: List[str] = ['fenced_code', 'codehilite', 'tables', 'sane_lists', 'attr_list']
    html_body: str = _to_html(md_text=processed_md, extensions=extensions)
    html_body = _apply_table_alignment(html_body)
    
    pygments_css: str = HtmlFormatter(style='default').get_style_defs('.codehilite')
    custom_css: str = _get_css()
    if css:
        custom_css = _get_md_text(input_file=css)
        
    logo_html: str = _get_logo_html(logo)

    full_html = _generate_html_output(
        custom_css=custom_css,
        pygments_css=pygments_css,
        logo_html=logo_html,
        html_body=html_body,
        ai_hidden_html=ai_hidden_html,
        metadata=metadata
    )

    _render_pdf(
        html=full_html,
        input_file_path=input_file,
        output_file_path=output_file,
        enable_metadata=extract_metadata
    )


def main():
    parser = argparse.ArgumentParser(description="Convert Markdown to a beautifully styled PDF.")
    parser.add_argument('-i', '--input', required=True, help="Path to the input Markdown file (.md)")
    parser.add_argument('-o', '--output', required=True, help="Path to the output PDF file (.pdf)")
    parser.add_argument('-l', '--logo', required=False, help="Path to the custom logo image file.")
    parser.add_argument('-s', '--css', required=False, help="Path to the custom CSS stylesheet.")
    parser.add_argument('-j', '--job', required=False, help="Path to a job description file to embed keywords and text into the hidden AI layer.")
    parser.add_argument('-m', '--metadata', action='store_true', help="Dynamically extract title, description, and keywords from the markdown text into PDF metadata.")

    args = parser.parse_args()
    convert_md_to_pdf(args.input, args.output, args.logo, args.css, args.metadata, args.job)


if __name__ == "__main__":
    main()

def get_dict_as_html(_dict: Dict[str, str], linebreaks: bool = False) -> str:
    output = []
    br = ', '
    if linebreaks:
        br = '</br>'
    for key, val in _dict.items():
        if key == 'website' or key == 'email':
            continue
        if val:
            if key == 'phone':
                val = f'Tel-{val}'
            output.append(val)
    return br.join(output)



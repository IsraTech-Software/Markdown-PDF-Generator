def crop_image_by_pixels(pdf_file_path, output_image_path):
    pdf_document = fitz.open(pdf_file_path)
    page = pdf_document[0]
    
    dpi = 600
    image = page.get_pixmap(matrix=fitz.Matrix(dpi / 72, dpi / 72))
    
    pil_image = Image.frombytes("RGB", [image.width, image.height], image.samples)
    gray_image = np.array(pil_image.convert("L"))
    _, binary_mask = cv2.threshold(gray_image, 1, 255, cv2.THRESH_BINARY)
    
    top, bottom, left, right = None, None, None, None
    
    for i in range(binary_mask.shape[0]):
        if np.any(binary_mask[i, :] == 0):
            top = i
            break
            
    for i in range(binary_mask.shape[0] - 1, -1, -1):
        if np.any(binary_mask[i, :] == 0):
            bottom = i
            break
            
    for i in range(binary_mask.shape[1]):
        if np.any(binary_mask[:, i] == 0):
            left = i
            break
            
    for i in range(binary_mask.shape[1] - 1, -1, -1):
        if np.any(binary_mask[:, i] == 0):
            right = i
            break
            
    if top is not None and bottom is not None and left is not None and right is not None:
        cropped_image = gray_image[top+60:bottom-60, left+60:right-60]
        cv2.imwrite(output_image_path, cropped_image)
        print(f'Saved cropped image as {output_image_path}')
    else:
        print('No outer black markers found.')


def _get_details():
    prompts = [
        'Enter Receiver Name: ',
        'Enter Receiver Address: ',
        'Enter Receiver Secondary Address (Optional): ',
        'Enter Receiver Tertiary Address (Optional): ',
        'Enter Receiver Postal Code and City: ',
        'Enter Receiver Country (Optional): '
    ]
    print("\n=== Paste multi-line address and/or CTRL+D to skip ===\n")
    raw_lines = sys.stdin.read().splitlines()
    pasted_data = [line.strip() for line in raw_lines if line.strip()]
    
    details = []
    for i, prompt in enumerate(prompts):
        # 2. If we already have a pasted line for this prompt index, use it silently
        if i < len(pasted_data):
            details.append(pasted_data[i])
            continue
            
        # 3. Otherwise, if the paste ran out, fallback to normal input
        val = input(prompt).strip()
        if val:
            details.append(val)
            
    phone = input('Enter Receiver Phone Number (Optional): ').replace(' ', '')
    if phone:
        details.append('Tel-' + phone)
        
    return [d for d in details if d]


def _replace_blanks(valid_details: List[str]) -> str:
    global REFERENCE_HTML
    content: str = REFERENCE_HTML
    for i in range(7): # 7 Blanks in the template
        if i < len(valid_details):
            content = content.replace('Blank', valid_details[i], 1)
        else:
            content = content.replace('Blank<br>\n', '', 1)
            content = content.replace('Blank<br>', '', 1)
            content = content.replace('Blank\n', '', 1)
            content = content.replace('Blank', '', 1)
    return content


def _get_stamp_base64(pdf_path: str, stamp_img: str) -> str:
    b64_stamp: str = ''
    if pdf_path and os.path.exists(pdf_path):
        print("\n--- Processing Stamp ---")
        crop_image_by_pixels(pdf_path, stamp_img)
        with open(stamp_img, "rb") as img_file:
            b64_stamp = base64.b64encode(img_file.read()).decode('utf-8')
    else:
        print("\n--- No stamp provided. Generating blank placeholder ---")
        blank_img = Image.new('RGB', (1, 1), color='white')
        buffer = BytesIO()
        blank_img.save(buffer, format="PNG")
        b64_stamp = base64.b64encode(buffer.getvalue()).decode('utf-8')
    return b64_stamp


def main():
    if not shutil.which("topdf"):
        print("Error: topdf not found")
        exit(1)
    stamp_img: str = 'stamp.png'
    pdf_path = sys.argv[1] if len(sys.argv) > 1 else None
    try:
    	details: List[str] = _get_details()
    except KeyboardInterrupt:
    	exit()
    b64_stamp: str = _get_stamp_base64(pdf_path=pdf_path, stamp_img=stamp_img)
    content: str = _replace_blanks(valid_details=details).replace('[STAMP_BASE64]', b64_stamp)

    temp_name: str = uuid.uuid4().hex
    working_md: str = f'{temp_name}.md'
    working_css: str = f'{temp_name}.css'

    with open(working_md, 'w+', encoding='utf-8') as f:
        f.write(content)
    with open(working_css, 'w+', encoding='utf-8') as f:
        f.write(REFERENCE_CSS)

    print("\nGenerating PDF...")
    cmd = f'topdf -i {working_md} -o output.pdf -s "{working_css}"'
    subprocess.run(cmd, shell=True)

    if os.path.exists(stamp_img):
        os.remove(stamp_img)
    if os.path.exists(working_md):
        os.remove(working_md)
    if os.path.exists(working_css):
        os.remove(working_css)

    print("\nDone! Envelope saved as output.pdf")


if __name__ == "__main__":
    main()
